---
interface Props {
  headings?: Array<{
    depth: number;
    slug: string;
    text: string;
  }>;
}

const { headings = [] } = Astro.props;

const toc = headings
  .filter((h) => h.depth >= 2 && h.depth <= 3)
  .map((h) => ({
    ...h,
    indent: h.depth === 2 ? 0 : 1,
  }));
---

{
  toc.length > 0 && (
    <aside class="hidden xl:block fixed right-0 top-20 w-64 pr-6">
      <div class="sticky top-8">
        <h3 class="text-xs font-semibold text-gray-700 uppercase tracking-wider mb-3">
          Sur cette page
        </h3>
        <nav class="space-y-2 text-sm">
          {toc.map((heading) => (
            <a
              href={`#${heading.slug}`}
              class={`block text-gray-600 hover:text-primary transition-colors ${
                heading.indent > 0 ? 'pl-4' : ''
              }`}
            >
              {heading.text}
            </a>
          ))}
        </nav>
      </div>
    </aside>
  )
}

<style>
  nav {
    max-width: 240px;
  }
</style>
